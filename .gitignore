# Dart / Flutter
.dart_tool/
.packages
build/
# Lockfiles: the two library packages ignore their lockfiles (Dart convention);
# the shipped app package commits its lockfile for reproducible builds (per the
# note that added the exception below).
pubspec.lock
!packages/workflow_step_editor_app/pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.vscode/

# OS
Thumbs.db
.DS_Store

# Release staging — keep the folder + its README, ignore all binaries & secrets
/dist/*
!/dist/README.md

# Android release-signing secrets — never committed, per-machine/per-developer
key.properties
*.jks
*.keystore

# Workflow-hook mid-task breadcrumb — machine-written, session-local, never committed
plans/UNFINISHED.md
